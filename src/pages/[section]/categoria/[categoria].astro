---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import ContactStrip from '../../../components/ContactStrip.astro';
import Icon from '../../../components/Icon.astro';
import { getCategoryRoutes, formatCount, type SectionSlug } from '../../../lib/catalog';
import { SECTIONS, sectionHref, sectionPath, sectionPathRoute } from '../../../data/navigation';

export const getStaticPaths: GetStaticPaths = async () => {
  const routes = await getCategoryRoutes();
  return routes.map((route) => ({
    // The URL segment comes from the section's `href`, not its data slug.
    params: { section: route.segment, categoria: route.category },
    props: { view: route.view, section: route.section },
  }));
};

interface Props {
  view: Awaited<ReturnType<typeof getCategoryRoutes>>[number]['view'];
  section: SectionSlug;
}

const { view, section } = Astro.props;

const sectionMeta = SECTIONS.find((entry) => entry.slug === section);
if (!sectionMeta) throw new Error(`Section metadata missing for "${section}"`);

const trail = [
  { name: 'Inicio', path: '/' },
  // Trail paths are base-less: `Breadcrumbs` applies the base itself.
  { name: sectionMeta.title, path: sectionPath(section) },
  { name: view.name, path: sectionPathRoute(section, 'categoria', view.slug) },
];
---

<BaseLayout
  title={`${view.name} — ${sectionMeta.title}`}
  description={`${formatCount(view.products.length)} de ${view.name.toLowerCase()} en Sweet Caroline, San Joaquín, Santiago.`}
  image={view.category.data.image ? undefined : undefined}
  breadcrumbs={trail}
>
  <PageHeader
    eyebrow={sectionMeta.title}
    title={view.name}
    description={formatCount(view.products.length)}
    trail={trail}
  />

  <section class="mx-auto max-w-6xl px-4 py-12" aria-label={`Productos en ${view.name}`}>
    {/* The grid sits directly under the page h1, so card titles are h2. */}
    <ProductGrid products={view.products} headingLevel="h2" />

    <p class="mt-10">
      <a
        href={sectionHref(section)}
        class="text-brand-700 inline-flex items-center gap-1 font-semibold hover:underline"
      >
        <Icon name="chevron-left" size={16} />
        <span>Volver a {sectionMeta.title}</span>
      </a>
    </p>
  </section>

  <ContactStrip />
</BaseLayout>
