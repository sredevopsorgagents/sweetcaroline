---
/**
 * Homepage: the Instagram feed.
 *
 * The site keeps only `Nosotros` and `Contacto` besides this page, so the
 * landing page is the shop window: the @sweetcarolinechile posts, embedded with
 * Instagram's official embed script, plus the shared contact strip. There is no
 * catalog here — product pages were retired (see docs/adr/0006).
 *
 * While `src/data/instagram.json` has no `posts`, the feed falls back to the
 * photographs already imported from WordPress, so the page never ships empty.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactStrip from '../components/ContactStrip.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Icon from '../components/Icon.astro';
import { requireImage } from '../lib/images';
import { SITE } from '../lib/site';
import { INSTAGRAM, INSTAGRAM_PROFILE_URL } from '../data/instagram';

const posts = INSTAGRAM.posts;
const guestPosts = INSTAGRAM.guestPosts;
const hasFeed = posts.length + guestPosts.length > 0;
const fallback = INSTAGRAM.fallback.map((photo) => ({
  ...photo,
  src: requireImage(photo.key),
}));
// The OG image has to be a local asset: `astro:assets` cannot optimise a remote
// file, and a build with no fallback photo simply omits the image.
const socialImage = fallback[0]?.src;
---

<BaseLayout
  title="Sweet Caroline | Pastelería fina y chocolatería en San Joaquín"
  description={SITE.description}
  image={socialImage}
  imageAlt={fallback[0]?.alt}
>
  <section class="bg-brand-50 border-brand-line-soft border-b">
    <div class="mx-auto max-w-6xl px-4 py-12 lg:py-16">
      <p class="text-accent-500 mb-2 text-sm font-semibold uppercase tracking-widest">
        @{INSTAGRAM.profile}
      </p>
      <h1 class="text-brand-900 text-3xl font-extrabold sm:text-4xl lg:text-5xl">
        Sweet Caroline en Instagram
      </h1>
      <p class="text-ink-700 mt-5 max-w-2xl text-lg">
        Lo último de nuestra pastelería: tortas a pedido, pastelería fina, chocolatería y
        nuestra terraza en San Joaquín.
      </p>
      <p class="mt-6">
        <a
          href={INSTAGRAM_PROFILE_URL}
          class="bg-brand-500 hover:bg-brand-700 inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold text-white transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="instagram" size={18} />
          <span>Ver el perfil en Instagram</span>
        </a>
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="feed">
    <h2 id="feed" class="text-brand-900 text-2xl font-bold sm:text-3xl">
      {hasFeed ? 'Publicaciones recientes' : 'Nuestras fotos'}
    </h2>

    {
      hasFeed ? (
        <div class="mt-8">
          <InstagramFeed posts={posts} guestPosts={guestPosts} />
        </div>
      ) : (
        <>
          <p class="text-ink-600 mt-3 max-w-2xl">
            Síguenos en Instagram para ver lo último que publicamos.
          </p>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {fallback.map((photo) => (
              <li>
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[320, 560, 840]}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                  loading="lazy"
                  class="w-full rounded-2xl"
                />
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>

  <ContactStrip />
</BaseLayout>
